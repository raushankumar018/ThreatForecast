# ==============================================================================
# PREVENT-X / ThreatForecast — Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & Editor Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs and Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Antigravity / Agent runtime artifacts
.agents/
.gemini/

# ------------------------------------------------------------------------------
# Python & Backend
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.mypy_cache/
.pytype/
.ruff_cache/

# Jupyter Notebooks
.ipynb_checkpoints/
*-checkpoint.ipynb

# ------------------------------------------------------------------------------
# Node.js & Frontend
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
!frontend/.env.example
!.env.example

# ------------------------------------------------------------------------------
# Runtime Logs & Telemetry Dumps
# ------------------------------------------------------------------------------
*.log
logs/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# PCAP Captures & Temporary Network Uploads
# ------------------------------------------------------------------------------
# Ignore uploaded or generated network capture files, but allow committed samples
*.pcap
*.pcapng
*.cap
!data/**/*.gitkeep
!artifacts/**/*.gitkeep
!tests/**/*.pcap
!tests/**/*.pcapng
!tests/**/*.cap
!data/samples/**/*.pcap
!data/samples/**/*.pcapng

# Temporary upload directories (keep folders tracked via .gitkeep, ignore contents)
**/uploads/*
!**/uploads/.gitkeep
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
backend/runtime/uploads/*
!backend/runtime/uploads/.gitkeep
tmp/
temp/
backend/temp/